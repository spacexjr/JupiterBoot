# JupiterBoot theme sample.
# Place as themes/default.ini (or another name referenced by config.ini's
# `theme = <name>`) inside the config root.
#
# Colour/metric keys mirror config.ini; these are applied first, then any
# matching keys in config.ini override them.

name = default

color_bg = #020202
color_fg = #20242C
color_border = #D88A4E
color_highlight = #B86837
color_text = #858585
color_text_sel = #FFFFFF
color_accent = #C87335

button_width = 430
button_height = 94
button_spacing = 12
button_radius = 7
button_border_width = 1
text_size = 19
